[
  {
    "label": "Build & Debug API",
    "build": {
      "command": "cargo",
      "args": ["build", "--bin", "api"]
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/api",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB"
  }
]
